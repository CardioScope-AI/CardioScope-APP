# Copier vers .env et renseigner un secret aleatoire long avant le lancement.
# Ne jamais commiter .env.
POSTGRES_PASSWORD=
CARDIOSCOPE_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Set true behind HTTPS in deployment. Use false only for local HTTP development.
AUTH_COOKIE_SECURE=true
# Exact browser origins, comma-separated, without a trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
