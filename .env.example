# Copier vers .env et renseigner un secret aleatoire long avant le lancement.
# Ne jamais commiter .env.
POSTGRES_PASSWORD=
CARDIOSCOPE_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Choisir une release complete presente dans DATA-ML/artifacts.
MODEL_PATH=/models/releases/rf-cleveland-v1/pipeline.joblib
# Exports complets, facultatifs, consultes uniquement pour comparaison.
COMPARISON_MODEL_PATHS=/models/releases/xgb-cleveland-v1/pipeline.joblib
# true en HTTPS ; false uniquement pour HTTP local.
AUTH_COOKIE_SECURE=true
# Exact browser origins, comma-separated, without a trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
